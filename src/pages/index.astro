---
import Layout from '../layouts/Layout.astro';
import Starfield from '../components/Starfield';
import Hero from '../components/Hero.astro';
import SectionNav from '../components/SectionNav';
import ProjectGrid from '../components/ProjectGrid.astro';
import SectionDivider from '../components/SectionDivider.astro';
import Timeline from '../components/Timeline';
import HobbiesCarousel from '../components/HobbiesCarousel.astro';
import Socials from '../components/Socials';
import Contact from '../components/Contact.astro';

const site = import.meta.env.SITE ?? 'https://huement.github.io/iRock/';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Derek Scott',
  jobTitle: 'Full Stack Web Developer',
  description:
    'Full Stack RockStar Web Developer. Expert with TypeScript, PHP & Python. 11 years of experience building web applications, and over 5 years building Java based Android Applications. I focus on UI/UX as well as AI automation.',
  url: site,
  image: `${site}github-johnny13.png`,
  email: 'admin@huement.com',
  knowsAbout: [
    'TypeScript',
    'PHP',
    'React',
    'Vue.js',
    'Laravel',
    'Node.js',
    'UI/UX',
  ],
  sameAs: [
    'https://github.com/johnny13',
    'https://www.linkedin.com/in/derekscott13/',
    'https://discordapp.com/users/johnnyfortune_21837',
  ],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of North Dakota',
  },
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Derek Scott | Developer Extraordinaire',
  url: site,
  description:
    'Full Stack RockStar Web Developer. Expert with TypeScript, PHP & Python. 11 years of experience building web applications, and over 5 years building Java based Android Applications. I focus on UI/UX as well as AI automation.',
  author: { '@type': 'Person', name: 'Derek Scott', url: site },
};
---

<Layout
  title="Derek Scott | Developer Extraordinaire"
  description="Full Stack RockStar Web Developer. Expert with TypeScript, PHP & Python. 11 years of experience building web applications, and over 5 years building Java based Android Applications. I focus on UI/UX as well as AI automation."
>
  <Starfield client:only="react" />

  <div style="min-height: 100vh;">
    <Hero />
  </div>

  <cosmic-wave
    class="fill-wave-medium nav-wave nav-wave-top"
    data-wave-points="10"
    data-wave-variance="2"
    data-wave-face="top"
    data-wave-speed="2000"
    data-circles="true"
    data-wave-animate="true"></cosmic-wave>

  <SectionNav client:load />
  <div class="bg-wave -mb-[1px] h-[20px]"></div>

  <cosmic-wave
    class="fill-wave-medium nav-wave nav-wave-bottom"
    data-wave-points="9"
    data-wave-variance="1"
    data-wave-face="bottom"
    data-wave-speed="1500"
    data-circles="true"
    data-wave-animate="true"></cosmic-wave>

  <ProjectGrid />

  <!-- Cyber HUD Seam Divider -->
  <SectionDivider />

  <div class="relative z-10">
    <Timeline client:only="react" />
  </div>

  <SectionDivider image="bottom-bar.svg" />

  <HobbiesCarousel />

  <div class="relative z-10" style="margin-top:-130px;margin-bottom: -130px;">
    <cosmic-wave
      class="fill-wave-ultra hobby-wave mobile-move-down z-[9999] mb-[-10px]"
      data-wave-points="11"
      data-wave-variance="2"
      data-wave-face="top"
      data-wave-speed="3333"
      data-wave-animate="true"
      data-circles="true"
      data-circlefill="fill-wave-ultra"></cosmic-wave>
    <div class="bg-ultra -mb-[1px] h-[200px]"></div>
    <cosmic-wave
      class="fill-wave-ultra hobby-wave relative"
      data-wave-points="14"
      data-wave-variance="3"
      data-wave-face="bottom"
      data-wave-speed="2000"
      data-wave-animate="true"
      data-circles="true"
      data-circlefill="fill-wave-ultra"></cosmic-wave>
  </div>
  <Socials client:only="react" />

  <cosmic-wave
    class="fill-wave hobby-wave mobile-move-down"
    data-wave-points="11"
    data-wave-variance="3"
    data-wave-face="top"
    data-wave-speed="2345"
    data-circles="true"
    data-wave-animate="true"></cosmic-wave>

  <Contact />

  <!-- Cycle .active on software tags for gradient flair -->

  <script
    type="application/ld+json"
    set:html={JSON.stringify([personSchema, websiteSchema])}
  />
</Layout>

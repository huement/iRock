---
// src/components/Contact.astro
import HudBox from './HudBox.astro';

const technologies = [
  'PHP',
  'Laravel',
  'Symfony',
  'SCSS',
  'SASS',
  'CSS',
  'HTML',
  'Svelte',
  'LESS',
  'Stylus',
  'SQL',
  'MySQL',
  'GraphQL',
  'MSSQL',
  'PostgreSQL',
  'PostGIS',
  'MariaDB',
  'SQLite',
  'Python',
  'Django',
  'JavaScript',
  'TypeScript',
  'Vue.js',
  'React.js',
  'Next.js',
  'Node.js',
  'AngularJS',
  'Ionic',
  'Capacitor',
  'Android',
  'iOS',
  'Java',
  'Swift',
];
---

<section
  id="contact"
  class="relative z-10 bg-wave py-20 overflow-hidden"
  role="contentinfo"
>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Column: Bio & Tech Stack -->
      <div
        class="lg:col-span-7 reveal-left opacity-0 -translate-x-8 transition-all duration-700 ease-out"
      >
        <div
          class="flex items-center gap-2 mb-3 font-mono text-xs font-bold text-cyan-400 uppercase tracking-widest"
        >
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>// PILOT_BIO :: SPEC_SHEET</span>
        </div>

        <h2
          class="text-4xl sm:text-5xl font-black font-saira uppercase tracking-tight text-white mb-6 cool-title"
        >
          Why Hire Me
        </h2>

        <!-- Tailwind Typography Container -->
        <div
          class="prose prose-invert prose-cyan max-w-none prose-p:text-slate-300 prose-p:leading-relaxed prose-strong:text-cyan-300 prose-strong:font-semibold mb-8"
        >
          <!-- Lead Paragraph -->
          <p
            class="text-xl text-slate-100 font-light leading-relaxed !mb-6 border-l-2 border-cyan-400/80 pl-4"
          >
            I bring a rare combination of rigorous math training and hands-on
            engineering—so I don’t just ship features; I design systems that
            behave correctly and scale.
          </p>

          <p>
            I care about iteration and evidence: A/B tests, metrics, and clear
            hypotheses. I’ve worked in regulated environments (U.S. Navy,
            government cloud) and high-velocity product teams, and I’m
            comfortable owning both the “why” and the “how” from data models to
            UI.
          </p>

          <p>
            I hold a <strong>B.S. in Statistics</strong> and a <strong
              >B.A. in Economics</strong
            > with a minor in Computer Science from the University of North Dakota.
            While in college, I immersed myself in complex behavioral and financial
            models, built a strong STEM foundation, and developed a deep passion for
            creating software.
          </p>

          <p>
            With over a decade of programming experience, I have a proven track
            record of delivering iterative, test-driven solutions. My unique
            background in economics and statistics allows me to build
            applications that are not only technically excellent but also make
            strong behavioral and financial sense. My advanced mathematical
            understanding enables me to tackle complex problems that many
            developers struggle with.
          </p>

          <p>
            Great software, however, is more than just algorithms and code.
            That’s where my design background shines. Before and during college
            I worked as a graphic designer, and I’ve continued refining those
            skills ever since. I specialize in creating beautiful, responsive,
            high-performance user interfaces with exceptional UX.
          </p>

          <p>
            My YouTube channel further showcases my animation skills and comedic
            timing. It’s rare to find a developer who can build a GraphQL API to
            exact specifications while also being highly proficient in design
            tools like Photoshop. I’m that versatile professional — the diamond
            in the rough — who can take your napkin sketch and turn it into a
            polished, functional, and visually compelling product.
          </p>
        </div>

        <!-- Software Tags Container -->
        <div class="border-t border-slate-800 pt-6">
          <p
            class="font-mono text-xs font-bold uppercase tracking-widest text-cyan-400/80 mb-3"
          >
            // KEY_TECHNOLOGIES:
          </p>

          <!-- Added 'transform-gpu' to isolate the flex wrapper layout -->
          <!-- Added padding (p-3) so box-shadows don't overflow the document bounds -->
          <div
            id="software-tags-wrap"
            class="flex flex-wrap gap-2 p-3 transform-gpu"
          >
            {
              technologies.map((tag) => (
                <span class="software-tag inline-flex items-center gap-1 px-3 py-1 text-xs font-mono font-semibold text-slate-300 bg-slate-900 border border-slate-800 rounded-md transition-[color,background-color,border-color,box-shadow] duration-300">
                  <span class="text-pink-500 font-bold">//</span>
                  {tag}
                </span>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Right Column: HUD Contact Box -->
      <div
        class="lg:col-span-5 reveal-right opacity-0 translate-x-8 transition-all duration-700 ease-out"
      >
        <HudBox seed={133713} title="COMMS // DIRECT_LINK" showScanline={false}>
          <div class="text-center mb-6">
            <h3
              class="text-2xl font-bold font-saira uppercase tracking-wider text-white mt-1"
            >
              Contact Options
            </h3>
          </div>

          <div class="flex flex-col gap-3.5">
            <!-- Direct Email (Flowbite Glowing Green) -->
            <a
              href="mailto:admin@huement.com"
              class="group relative inline-flex items-center justify-between px-5 py-3.5 text-xs font-mono font-bold tracking-widest text-slate-950 uppercase bg-emerald-400 hover:bg-emerald-300 rounded-lg transition-all shadow-[0_0_20px_rgba(52,211,153,0.4)] hover:shadow-[0_0_30px_rgba(52,211,153,0.7)] focus:ring-4 focus:outline-none focus:ring-emerald-300 dark:focus:ring-emerald-800 hover:-translate-y-0.5 active:translate-y-0"
            >
              <div class="flex items-center gap-3">
                <i
                  class="bx bxs-envelope text-xl transition-transform group-hover:scale-110"
                ></i>
                <span>Email Direct</span>
              </div>
              <i
                class="bx bx-right-arrow-alt text-lg group-hover:translate-x-1 transition-transform ms-2"
              ></i>
            </a>

            <!-- Resume Download (Glowing Cyan) -->
            <a
              href="https://drive.google.com/file/d/12iPY5GhldMc1_CVRw1VqAyNbo3dAn3t2/view?usp=sharing"
              target="_blank"
              rel="noopener noreferrer"
              class="group relative inline-flex items-center justify-between px-5 py-3.5 text-xs font-mono font-bold tracking-widest text-slate-950 uppercase bg-cyan-400 hover:bg-cyan-300 rounded-lg transition-all shadow-[0_0_20px_rgba(6,182,212,0.4)] hover:shadow-[0_0_30px_rgba(6,182,212,0.7)] focus:ring-4 focus:outline-none focus:ring-cyan-300 dark:focus:ring-cyan-800 hover:-translate-y-0.5 active:translate-y-0"
            >
              <div class="flex items-center gap-3">
                <i
                  class="bx bxs-download text-xl transition-transform group-hover:scale-110"
                ></i>
                <span>Resume Download</span>
              </div>
              <i
                class="bx bx-export text-lg group-hover:translate-x-1 transition-transform ms-2"
              ></i>
            </a>

            <!-- GitHub (Glowing Purple / Violet) -->
            <a
              href="https://github.com/johnny13"
              target="_blank"
              rel="noopener noreferrer"
              class="group relative inline-flex items-center justify-between px-5 py-3.5 text-xs font-mono font-bold tracking-widest text-white uppercase bg-purple-600 hover:bg-purple-500 rounded-lg transition-all shadow-[0_0_20px_rgba(168,85,247,0.4)] hover:shadow-[0_0_30px_rgba(168,85,247,0.7)] focus:ring-4 focus:outline-none focus:ring-purple-300 dark:focus:ring-purple-800 hover:-translate-y-0.5 active:translate-y-0"
            >
              <div class="flex items-center gap-3">
                <i
                  class="bx bxl-github text-xl transition-transform group-hover:scale-110"
                ></i>
                <span>GitHub Profile</span>
              </div>
              <i
                class="bx bx-right-arrow-alt text-lg group-hover:translate-x-1 transition-transform ms-2"
              ></i>
            </a>

            <!-- LinkedIn (Glowing Blue) -->
            <a
              href="https://www.linkedin.com/in/derekscott13/"
              target="_blank"
              rel="noopener noreferrer"
              class="group relative inline-flex items-center justify-between px-5 py-3.5 text-xs font-mono font-bold tracking-widest text-white uppercase bg-blue-600 hover:bg-blue-500 rounded-lg transition-all shadow-[0_0_20px_rgba(37,99,235,0.4)] hover:shadow-[0_0_30px_rgba(37,99,235,0.7)] focus:ring-4 focus:outline-none focus:ring-blue-300 dark:focus:ring-blue-800 hover:-translate-y-0.5 active:translate-y-0"
            >
              <div class="flex items-center gap-3">
                <i
                  class="bx bxl-linkedin text-xl transition-transform group-hover:scale-110"
                ></i>
                <span>LinkedIn Profile</span>
              </div>
              <i
                class="bx bx-right-arrow-alt text-lg group-hover:translate-x-1 transition-transform ms-2"
              ></i>
            </a>
          </div>
        </HudBox>
      </div>
    </div>
  </div>
  <!-- Astronaut Graphic (Hidden on mobile, scaled for tablet & desktop) -->
  <div
    class="animate-float-space absolute pointer-events-none z-10 hidden md:block md:top-[64%] md:right-[2%] md:w-[120px] md:h-[120px] md:opacity-40 lg:top-[50%] lg:right-[4%] lg:w-[200px] lg:h-[200px] lg:opacity-60 bg-[url('../assets/artwork/astro.svg')] bg-contain bg-no-repeat bg-center"
  >
  </div>

  <!-- Background Dot Matrix -->
  <div
    class="absolute inset-0 pointer-events-none z-0 opacity-30 md:opacity-45 bg-[url('../assets/artwork/dots.svg')] bg-contain bg-no-repeat bg-center"
  >
  </div>

  <!-- Space Shuttle Graphic -->
  <div
    class="animate-float-space absolute pointer-events-none z-10 hidden md:block md:bottom-[3%] md:right-[8%] md:w-[120px] md:h-[120px] md:opacity-30 lg:bottom-[7%] lg:right-[24%] lg:w-[200px] lg:h-[200px] lg:opacity-45 bg-[url('../assets/artwork/shuttle.svg')] bg-contain bg-no-repeat bg-center"
  >
  </div>
</section>

<script>
  function setupContactSection() {
    // 1. Technology Tag Cycling Logic
    const wrap = document.getElementById('software-tags-wrap');
    if (wrap) {
      const tags = wrap.querySelectorAll('.software-tag');
      if (tags.length) {
        let index = 0;
        setInterval(() => {
          tags.forEach((t) => {
            t.classList.remove(
              'border-cyan-400',
              'bg-cyan-950/80',
              'text-cyan-300',
              'shadow-[0_0_12px_rgba(0,240,255,0.4)]'
            );
            t.classList.add(
              'border-slate-800',
              'bg-slate-900',
              'text-slate-300'
            );
          });

          const currentTag = tags[index];
          if (currentTag) {
            currentTag.classList.remove(
              'border-slate-800',
              'bg-slate-900',
              'text-slate-300'
            );
            currentTag.classList.add(
              'border-cyan-400',
              'bg-cyan-950/80',
              'text-cyan-300',
              'shadow-[0_0_12px_rgba(0,240,255,0.4)]'
            );
          }

          index = (index + 1) % tags.length;
        }, 2200);
      }
    }

    // 2. Directional Scroll Reveal Observer
    const contactSection = document.getElementById('contact');
    if (contactSection) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const leftEl = entry.target.querySelector('.reveal-left');
              const rightEl = entry.target.querySelector('.reveal-right');

              if (leftEl) {
                leftEl.classList.remove('opacity-0', '-translate-x-8');
                leftEl.classList.add('is-visible');
              }
              if (rightEl) {
                rightEl.classList.remove('opacity-0', 'translate-x-8');
                rightEl.classList.add('is-visible');
              }

              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -80px 0px', threshold: 0.15 }
      );

      observer.observe(contactSection);
    }
  }

  document.addEventListener('DOMContentLoaded', setupContactSection);
  document.addEventListener('astro:page-load', setupContactSection);
</script>

---
// src/components/Hero.astro
import { heroData } from '../data/portfolio';
import HudBox from './HudBox.astro';
---

<section
  class="hero-section flex items-center justify-center min-h-screen relative z-10 px-4 py-12"
  role="banner"
>
  <div class="hero-entrance-wrap w-full max-w-4xl mx-auto">
    <HudBox title="NAV.SYSTEM // COMMAND_CENTER" showScanline={true}>
      <div class="text-center flex flex-col items-center">
        <!-- Name Title -->
        <h1
          class="cyber-wave-text font-extrabold tracking-tight hero-title cool-title mb-3 cursor-pointer drop-shadow-[0_0_25px_rgba(0,240,255,0.4)]"
          data-text={heroData.name}
          data-stagger="16"
          data-shuffle="160"
        >
          {heroData.name}
        </h1>

        <!-- Tagline -->
        <span
          class="cyber-wave-text text-sm sm:text-lg font-mono uppercase tracking-[0.2em] text-cyan-300/80 mb-6 block cursor-pointer"
          data-text={heroData.tagline}
          data-stagger="12"
          data-shuffle="140"
        >
          {heroData.tagline}
        </span>

        <!-- Intro Text (Fast Wave Sweep) -->
        <p
          class="cyber-wave-text text-base sm:text-lg text-slate-300 font-light max-w-2xl leading-relaxed mb-8"
          data-text={heroData.intro}
          data-stagger="4"
          data-shuffle="100"
        >
          {heroData.intro}
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap gap-4 justify-center items-center">
          <a
            href="#work"
            class="relative inline-flex items-center justify-center gap-2.5 px-6 py-3 font-mono text-xs font-bold tracking-widest text-white uppercase transition-all duration-300 rounded-lg bg-gradient-to-r from-cyan-500 via-teal-500 to-blue-600 hover:bg-gradient-to-br focus:ring-4 focus:outline-none focus:ring-cyan-800 shadow-lg shadow-cyan-500/40 hover:shadow-cyan-500/80 hover:-translate-y-0.5 active:translate-y-0 group"
          >
            <i
              class="bx bxs-rocket text-lg text-cyan-200 transition-transform duration-300 group-hover:scale-125 group-hover:rotate-12"
            ></i>
            <span>Launch Work</span>
            <span
              class="inline-flex items-center justify-center w-2 h-2 rounded-full bg-cyan-200 animate-pulse"
            ></span>
          </a>

          <a
            href="#contact"
            class="relative inline-flex items-center justify-center gap-2.5 px-6 py-3 font-mono text-xs font-bold tracking-widest uppercase transition-all duration-300 rounded-lg text-cyan-400 bg-slate-900/60 backdrop-blur-md border border-cyan-500/40 hover:border-cyan-400 hover:text-white hover:bg-cyan-500/20 focus:ring-4 focus:outline-none focus:ring-cyan-900 shadow-md hover:shadow-[0_0_20px_rgba(0,240,255,0.4)] hover:-translate-y-0.5 group"
          >
            <i
              class="bx bxs-paper-plane text-lg text-cyan-400 group-hover:text-cyan-200 group-hover:translate-x-1 transition-transform duration-300"
            ></i>
            <span>Transmit Signal</span>
          </a>
        </div>
      </div>
    </HudBox>
  </div>
</section>
<script>
  import Rellax from 'rellax';

  const SYMBOLS = '!§$%&/()=?_<>^°*#-:~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';

  // 1. Entrance & Parallax Initialization
  const entranceWrap = document.querySelector('.hero-entrance-wrap');
  if (entranceWrap) {
    entranceWrap.classList.add('is-visible');
    new Rellax(entranceWrap, { speed: 1.2 });
  }

  // 2. Zero-Shift Cyber Wave Engine
  function triggerCyberWave(el: HTMLElement) {
    const fullText = el.dataset.text || el.textContent || '';
    if (!fullText.trim()) return;

    if (window.innerWidth < 500) {
      el.textContent = fullText;
      return;
    }

    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    if (prefersReducedMotion) {
      el.textContent = fullText;
      return;
    }

    const staggerMs = parseInt(el.dataset.stagger || '8', 10);
    const shuffleMs = parseInt(el.dataset.shuffle || '140', 10);

    let animWrapper = el.querySelector<HTMLElement>('.cyber-anim-wrapper');

    // Build layout-locked DOM structure once
    if (!animWrapper) {
      animWrapper = document.createElement('span');
      animWrapper.className = 'cyber-anim-wrapper';
      animWrapper.setAttribute('aria-hidden', 'true');

      // Split into word groups to preserve clean multi-line wrapping
      const words = fullText.split(' ');

      words.forEach((word, wIdx) => {
        const wordSpan = document.createElement('span');
        wordSpan.className = 'inline-block whitespace-nowrap';

        word.split('').forEach((char) => {
          const charSpan = document.createElement('span');
          charSpan.textContent = char;
          charSpan.dataset.char = char;
          charSpan.className =
            'inline-block text-center transition-colors duration-75';
          wordSpan.appendChild(charSpan);
        });

        animWrapper?.appendChild(wordSpan);

        // Add space between words
        if (wIdx < words.length - 1) {
          const spaceSpan = document.createElement('span');
          spaceSpan.textContent = '\u00A0';
          spaceSpan.dataset.char = ' ';
          spaceSpan.className = 'inline-block';
          animWrapper?.appendChild(spaceSpan);
        }
      });

      el.innerHTML = '';
      el.appendChild(animWrapper);

      // Lock each character span to its target width so shuffle symbols don't cause reflows
      const charSpans =
        animWrapper.querySelectorAll<HTMLElement>('span[data-char]');
      charSpans.forEach((span) => {
        if (span.dataset.char !== ' ') {
          const width = span.getBoundingClientRect().width;
          if (width > 0) {
            span.style.width = `${width}px`;
          }
        }
      });
    }

    // Run Wave Animation
    const charSpans = Array.from(
      animWrapper.querySelectorAll<HTMLElement>('span[data-char]')
    );
    const startTime = performance.now();

    function animate(now: number) {
      const elapsed = now - startTime;
      let isComplete = true;

      charSpans.forEach((span, index) => {
        const targetChar = span.dataset.char;
        if (targetChar === ' ' || targetChar === '\u00A0') return;

        const charStart = index * staggerMs;
        const charEnd = charStart + shuffleMs;

        if (elapsed < charStart) {
          span.textContent =
            SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)];
          span.style.opacity = '0.35';
          span.style.color = '#00f0ff';
          span.style.webkitTextFillColor = '#00f0ff';
          isComplete = false;
        } else if (elapsed >= charStart && elapsed < charEnd) {
          span.textContent =
            SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)];
          span.style.opacity = '1';
          span.style.color = '#ff0055';
          span.style.webkitTextFillColor = '#ff0055';
          isComplete = false;
        } else {
          span.textContent = targetChar || '';
          span.style.opacity = '1';
          span.style.color = '';
          span.style.webkitTextFillColor = '';
        }
      });

      if (!isComplete) {
        requestAnimationFrame(animate);
      }
    }

    requestAnimationFrame(animate);
  }

  // Initialize all wave elements & attach hover listeners
  const waveElements =
    document.querySelectorAll<HTMLElement>('.cyber-wave-text');

  waveElements.forEach((el) => {
    triggerCyberWave(el);
    el.addEventListener('mouseover', () => triggerCyberWave(el));
  });
</script>

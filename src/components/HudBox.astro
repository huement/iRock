---
import { generateHudFrameSVG } from '../utils/hudGenerator';

interface Props {
  seed?: number;
  width?: number;
  height?: number;
  glow?: boolean;
  title?: string;
  class?: string;
  showScanline?: boolean;
}

// Generates a random 6-digit seed (100000 - 999999)
const randomNum = Math.floor(Math.random() * 900000) + 100000;

const {
  seed = randomNum,
  width = 840,
  height = 420,
  glow = true,
  title = 'SYS.HUD // v2.0',
  class: className = '',
  showScanline = true,
} = Astro.props;

const { svgMarkup } = generateHudFrameSVG({ w: width, h: height, seed, glow });
---

<div
  class={`hud-box-component relative group ${className}`}
  data-width={width}
  data-height={height}
  data-glow={glow ? 'true' : 'false'}
>
  <!-- Procedural Vector Frame SVG -->
  <div class="hud-svg-container">
    <Fragment set:html={svgMarkup} />
  </div>

  <!-- Animated Sci-Fi Opaque Grid Background -->
  <div
    class="absolute inset-2 pointer-events-none rounded-lg overflow-hidden z-0 opacity-40"
  >
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,240,255,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,240,255,0.08)_1px,transparent_1px)] bg-[size:24px_24px]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_50%,transparent_20%,rgba(10,10,15,0.95)_100%)]"
    >
    </div>
  </div>

  <!-- Animated Scanline Laser -->
  {
    showScanline && (
      <div class="absolute inset-x-4 h-0.5 bg-cyan-400/80 shadow-[0_0_12px_#00f0ff] z-10 pointer-events-none animate-hud-scan opacity-70" />
    )
  }

  <!-- Top Status HUD Bar -->
  <div
    class="absolute bottom-0 left-8 right-8 md:flex hidden justify-between items-center z-20 pointer-events-none font-mono text-[10px] tracking-widest text-cyan-400/80 uppercase"
  >
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
      <span>{title}</span>
    </div>
    <div class="hidden sm:flex items-center gap-3 text-cyan-500/60">
      <span>LOC: 0x88F</span>
      <span>PWR: 99.8%</span>
    </div>
  </div>

  <!-- Corner Targeting Reticles -->
  <div
    class="absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-cyan-400 z-20 pointer-events-none"
  >
  </div>
  <div
    class="absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-cyan-400 z-20 pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-cyan-400 z-20 pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-cyan-400 z-20 pointer-events-none"
  >
  </div>

  <!-- Slotted Content Container -->
  <div class="relative z-10 p-6 sm:p-10 md:p-12">
    <slot />
  </div>
</div>

<style>
  @keyframes hud-scan {
    0% {
      top: 8%;
      opacity: 0;
    }
    15% {
      opacity: 0.8;
    }
    85% {
      opacity: 0.8;
    }
    100% {
      top: 90%;
      opacity: 0;
    }
  }

  .animate-hud-scan {
    animation: hud-scan 6s ease-in-out infinite;
  }
</style>

<script>
  import { generateHudFrameSVG } from '../utils/hudGenerator';

  function initializeDynamicHud() {
    const hudContainers =
      document.querySelectorAll<HTMLElement>('.hud-box-component');

    hudContainers.forEach((hudContainer) => {
      const width = parseInt(hudContainer.dataset.width || '840', 10);
      const height = parseInt(hudContainer.dataset.height || '420', 10);
      const glow = hudContainer.dataset.glow === 'true';

      const svgWrapper = hudContainer.querySelector('.hud-svg-container');
      if (!svgWrapper) return;

      const redraw = () => {
        const seed = Math.floor(Math.random() * 900000) + 100000;
        const { svgMarkup } = generateHudFrameSVG({
          w: width,
          h: height,
          seed,
          glow,
        });
        svgWrapper.innerHTML = svgMarkup;
      };

      // Set interval for subsequent random redraws (10s - 20s)
      const randomInterval = () => Math.random() * 10000 + 10000;
      let redrawInterval = setInterval(redraw, randomInterval());

      // Redraw when scrolling back to the top
      let isAtTop = window.scrollY < 5;
      window.addEventListener(
        'scroll',
        () => {
          const currentlyAtTop = window.scrollY < 5;
          if (currentlyAtTop && !isAtTop) {
            redraw();
            clearInterval(redrawInterval);
            redrawInterval = setInterval(redraw, randomInterval());
          }
          isAtTop = currentlyAtTop;
        },
        { passive: true }
      );
    });
  }

  // Run on initial page load & Astro View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeDynamicHud);
  } else {
    initializeDynamicHud();
  }

  document.addEventListener('astro:page-load', initializeDynamicHud);
</script>

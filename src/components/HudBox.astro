---
import { generateHudFrameSVG } from '../utils/hudGenerator';

interface Props {
  seed?: number;
  width?: number;
  height?: number;
  glow?: boolean;
  title?: string;
  class?: string;
  showScanline?: boolean;
}

const {
  seed = 898766,
  width = 840,
  height = 420,
  glow = true,
  title = 'SYS.HUD // v2.0',
  class: className = '',
  showScanline = true,
} = Astro.props;

const { svgMarkup } = generateHudFrameSVG({ w: width, h: height, seed, glow });
---

<div class={`relative group ${className}`}>
  <!-- Procedural Vector Frame SVG -->
  <Fragment set:html={svgMarkup} />

  <!-- Animated Sci-Fi Opaque Grid Background -->
  <div class='absolute inset-2 pointer-events-none rounded-lg overflow-hidden z-0 opacity-40'>
    <div
      class='absolute inset-0 bg-[linear-gradient(to_right,rgba(0,240,255,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,240,255,0.08)_1px,transparent_1px)] bg-[size:24px_24px]'>
    </div>
    <div
      class='absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_50%,transparent_20%,rgba(10,10,15,0.95)_100%)]'>
    </div>
  </div>

  <!-- Animated Scanline Laser -->
  {
    showScanline && (
      <div class='absolute inset-x-4 h-0.5 bg-cyan-400/80 shadow-[0_0_12px_#00f0ff] z-10 pointer-events-none animate-hud-scan opacity-70' />
    )
  }

  <!-- Top Status HUD Bar -->
  <div
    class='absolute bottom-0 left-8 right-8 flex justify-between items-center z-20 pointer-events-none font-mono text-[10px] tracking-widest text-cyan-400/80 uppercase'>
    <div class='flex items-center gap-2'>
      <span class='w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping'></span>
      <span>{title}</span>
    </div>
    <div class='hidden sm:flex items-center gap-3 text-cyan-500/60'>
      <span>LOC: 0x88F</span>
      <span>PWR: 99.8%</span>
    </div>
  </div>

  <!-- Corner Targeting Reticles -->
  <div class='absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-cyan-400 z-20 pointer-events-none'></div>
  <div class='absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-cyan-400 z-20 pointer-events-none'></div>
  <div class='absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-cyan-400 z-20 pointer-events-none'></div>
  <div class='absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-cyan-400 z-20 pointer-events-none'></div>

  <!-- Slotted Content Container -->
  <div class='relative z-10 p-6 sm:p-10 md:p-12'>
    <slot />
  </div>
</div>

<style>
  @keyframes hud-scan {
    0% {
      top: 8%;
      opacity: 0;
    }
    15% {
      opacity: 0.8;
    }
    85% {
      opacity: 0.8;
    }
    100% {
      top: 90%;
      opacity: 0;
    }
  }

  .animate-hud-scan {
    animation: hud-scan 6s ease-in-out infinite;
  }
</style>
